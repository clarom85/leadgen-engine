# Database — usa stesso pattern del content network (Neon serverless)
DATABASE_URL=postgresql://USER:PASS@HOST/DBNAME?sslmode=require

# Compliance / TCPA
TRUSTEDFORM_API_KEY=
JORNAYA_ACCOUNT_ID=

# Node env
NODE_ENV=development

# Auction settings
PING_TIMEOUT_MS=2500
MAX_PARALLEL_PINGS=20

# Encryption key per buyer auth_config (32 bytes hex)
BUYER_AUTH_ENCRYPTION_KEY=
